# Copy to .env and fill in. Never commit .env.

# paper = simulated fills against live quotes (default). live = real money on Robinhood.
TRADING_MODE=paper

# Robinhood login (live mode). The TOTP secret is the setup key Robinhood shows when you
# turn on an authenticator app for 2FA; it lets the daemon log in again without you.
RH_USERNAME=
RH_PASSWORD=
RH_TOTP_SECRET=

# Hard caps. The dashboard can't go above these.
MAX_DOLLARS_PER_TICKER=1000
MAX_DOLLARS_PER_NIGHT=5000

# Paper mode
PAPER_STARTING_CASH=10000
# yahoo = real quotes from Yahoo Finance. demo = made-up prices for trying the app offline.
QUOTE_SOURCE=yahoo

# Notifications: fill in either or both.
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Password for the web dashboard.
DASHBOARD_PASSWORD=

# Where the database and Robinhood session are stored.
DATA_DIR=data
